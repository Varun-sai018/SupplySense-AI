# Docker-internal execution (when Python services are containerized)
# Note: Python services are not yet containerized in Phase 3, 
# but this file illustrates the configuration they will use inside Docker.
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=supplysense

KAFKA_BROKER=kafka:9092
KAFKA_TOPIC_EVENTS=dataset-events
KAFKA_CONSUMER_GROUP=dependency-engine

OLIST_DATA_DIR=/app/data/raw_csv
